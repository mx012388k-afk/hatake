  "conditionTypes": {
    "daysSince":  "指定イベントからの経過日数 { event, gte?, lte?, dueBy? }。lte は超えたら不成立、dueBy は超えても成立のまま「遅れ気味」として表示",
    "gddSince":   "指定イベントからの積算温度（日平均気温-base の正の値を合計）{ event, base, gte?, lte? }",
    "calendar":   "暦の期間 { from: 'MM-DD', to: 'MM-DD' }（年をまたぐ場合 from > to）",
    "stage":      "現在の生育ステージ { in: [stageId] }",
    "eventDone":  "作業イベントの実施有無 { event, done: true|false }",
    "forecast":   "予報値（出典付きで中継したもの）{ metric: precipSum|tempMin|tempMax, days, op: gte|lte, value }",
    "observed":   "観測値 { metric: dryDays|precipSum, days?, op, value }"
  },

